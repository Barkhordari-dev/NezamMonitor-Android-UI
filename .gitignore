# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat

# Android Studio
.idea/
*.iml
local.properties
captures/
.externalNativeBuild/
.cxx/

# Keystore (NEVER commit)
*.jks
*.keystore
keystore.properties
signing.properties

# Build outputs
app/build/
app/release/

# OS files
.DS_Store
Thumbs.db

# Secrets & Credentials
.env
*.env
credentials.json
tokens.json
secrets/

# 9Router / AI Studio credentials
9router_key*
ai_studio_key*
api_keys/

# Browser sessions
*.cookies
*.session
browser_data/

# Temp files
*.tmp
*.bak
*.swp

# B Nazanin fonts: decoded at build time from fonts-src/*.b64 (see the
# decodeFonts task in app/build.gradle.kts) — never commit the binaries.
app/src/main/assets/fonts/*.ttf

# Launcher icon variants (v3.8.5, generated at build time, never committed)
app/src/main/res/mipmap-hdpi/ic_launcher_green.png
app/src/main/res/mipmap-hdpi/ic_launcher_gold.png
app/src/main/res/mipmap-hdpi/ic_launcher_dark.png
